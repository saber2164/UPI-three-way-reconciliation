# Local credentials and settings for the standalone stack.
# Copy to .env and adjust; every value below is a local-development default.

# --- Postgres (the serving store for recon.*) -----------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=fintech

# --- MinIO / S3 (the Iceberg warehouse) -----------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_REGION=ap-south-1
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_REST_URI=http://iceberg-rest:8181

# --- Kafka / Schema Registry ----------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
SCHEMA_REGISTRY=http://schema-registry:8081

# --- Demo behaviour -------------------------------------------------------
# 60 = 4 h settlement SLA becomes 240 s, the 24 h repair bound becomes 1,440 s.
# Use 1 for production timing.
TIME_SCALE=60
# Transactions per second.  The bounded interval-join state is rate x window,
# so 500 tps does not fit on an 8 GB laptop.
TPS=100
FAULT_RATE=0.03
# The merchant that concentrates traffic and faults, so the alert threshold fires.
BAD_MERCHANT=M0001
BAD_MERCHANT_RATE=0.20
BAD_MERCHANT_FAULT_RATE=0.35
# Every Nth transaction gets a deterministic round-robin fault.
FORCE_FAULT_EVERY=500
